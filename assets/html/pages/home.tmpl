{{define "page:title"}}City Trip Planner{{end}}

{{define "page:content"}}
<section>
    <div style="margin-bottom: 2rem;">
        <h2>Plan a Custom City Trip</h2>
        <p class="muted">Explore urban destinations and craft personalized travel itineraries.</p>
    </div>

    <div id="form-errors">
        {{if .FormErrors}}
            {{template "form_errors" .FormErrors}}
        {{end}}
    </div>

    <form hx-post="/trips" hx-target="#trip-list" hx-swap="afterbegin" hx-on::after-request="if(event.detail.successful) { this.reset(); const empty = document.getElementById('empty-state'); if(empty) empty.remove(); const errs = document.getElementById('form-errors'); if(errs) errs.innerHTML = ''; }">
        <div class="grid">
            <label for="destination">
                Destination City
                <input type="text" id="destination" name="destination" placeholder="e.g. Kyoto, Barcelona, Amsterdam" value="{{.FormValues.Destination}}" required>
            </label>
            <label for="duration_days">
                Duration (Days)
                <input type="number" id="duration_days" name="duration_days" min="1" max="30" value="{{if .FormValues.DurationDays}}{{.FormValues.DurationDays}}{{else}}3{{end}}" required>
            </label>
        </div>

        <label for="notes">
            Trip Notes & Interests
            <textarea id="notes" name="notes" rows="3" placeholder="Must-see sights, food preferences, neighborhoods to explore...">{{.FormValues.Notes}}</textarea>
        </label>

        <button type="submit">Create Trip Itinerary</button>
    </form>
</section>

<hr style="margin: 2.5rem 0;">

<section>
    <h3>Saved City Trips</h3>
    {{template "trip_list" .}}
</section>
{{end}}
