{{define "stop_card"}}
<article class="highlight-card stop-card">
    <div class="card-image-wrap" style="overflow:hidden; border-radius: 8px 8px 0 0; max-height: 240px;">
        <img src="{{.ImageURL}}" alt="{{if .ImageAlt}}{{.ImageAlt}}{{else}}{{.Title}}{{end}}" style="width:100%; height: 220px; object-fit: cover; display:block;" loading="lazy" />
    </div>
    <header class="card-header" style="padding-top: 0.75rem;">
        <div class="card-meta">
            <span class="badge {{categoryBadgeClass .Kind}}">{{categoryIcon .Kind}} {{.Kind}}</span>
            {{if .Neighborhood}}<span class="neighborhood-tag">📍 {{.Neighborhood}}</span>{{end}}
            {{if .RecommendedMinutes}}<span class="neighborhood-tag">⏱️ {{.RecommendedMinutes}} min</span>{{end}}
        </div>
    </header>
    <div class="card-content">
        <h4 style="margin-bottom: 0.35rem;">{{.Title}}</h4>
        <p class="story-text" style="margin-bottom: 0.5rem;">{{.Body}}</p>
        {{if .Tip}}
            <div class="card-tip">
                <small>💡 <strong>Tip:</strong> {{.Tip}}</small>
            </div>
        {{end}}
    </div>
    <footer class="card-actions">
        <div class="grid btn-group">
            <a href="{{osmLink .Title .Lat .Lon}}" target="_blank" rel="noopener noreferrer" class="outline btn-sm secondary" role="button">OpenStreetMap</a>
            <a href="{{googleMapsLink .Title .Lat .Lon}}" target="_blank" rel="noopener noreferrer" class="outline btn-sm secondary" role="button">Google Maps</a>
            <a href="{{wikiLink .WikiQuery .Title}}" target="_blank" rel="noopener noreferrer" class="outline btn-sm contrast" role="button">Wikipedia</a>
        </div>
    </footer>
</article>
{{end}}
