{{define "trip_card"}}
<article class="highlight-card">
    <header class="card-header">
        <div class="card-meta">
            <span class="badge {{categoryBadgeClass .Category}}">{{categoryIcon .Category}} {{.Category}}</span>
            {{if .Neighborhood}}
                <span class="neighborhood-tag">📍 {{.Neighborhood}}</span>
            {{end}}
        </div>
    </header>

    <div class="card-content">
        <h4>{{.Title}}</h4>
        <p class="story-text">{{.Story}}</p>

        {{if .Tip}}
            <div class="card-tip">
                <small>💡 <strong>Insider Tip:</strong> {{.Tip}}</small>
            </div>
        {{end}}

        {{if or .WalkingMinutes .TransitTip}}
            <div class="card-logistics">
                <small>
                    {{if .WalkingMinutes}}🚶 {{.WalkingMinutes}} min walk{{end}}
                    {{if and .WalkingMinutes .TransitTip}} • {{end}}
                    {{if .TransitTip}}🚌 {{.TransitTip}}{{end}}
                </small>
            </div>
        {{end}}
    </div>

    <footer class="card-actions">
        <div class="grid btn-group">
            <a href="{{osmLink .Title .Lat .Lon}}" target="_blank" rel="noopener noreferrer" class="outline btn-sm secondary" role="button">
                OpenStreetMap
            </a>
            <a href="{{googleMapsLink .Title .Lat .Lon}}" target="_blank" rel="noopener noreferrer" class="outline btn-sm secondary" role="button">
                Google Maps
            </a>
            <a href="{{wikiLink .WikiQuery .Title}}" target="_blank" rel="noopener noreferrer" class="outline btn-sm contrast" role="button">
                Wikipedia
            </a>
        </div>
    </footer>
</article>
{{end}}
